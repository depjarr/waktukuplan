# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Kunci rahasia: HANYA dipakai di server (webhook WhatsApp). Jangan pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Claude (console.anthropic.com) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model yang dipakai bot. Haiku cepat dan murah, cukup untuk urusan jadwal.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- WhatsApp Cloud API (developers.facebook.com) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bebas kamu isi sendiri, harus sama dengan yang kamu tulis di dashboard Meta saat pasang webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta App > Settings > Basic), dipakai untuk memeriksa tanda tangan webhook
WHATSAPP_APP_SECRET=
# Nomor bot untuk ditampilkan ke user, format internasional tanpa +, misal 628123456789
NEXT_PUBLIC_WA_BOT_NUMBER=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=waktukuplan-images
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.namadomainkamu.com
